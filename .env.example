# Base de datos
DB_URL=postgresql://user:password@localhost:5432/knowledge

# OpenSearch
OPENSEARCH_URL=https://user:password@localhost:9200

# Wasabi S3
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_BUCKET_NAME=knowledgehoss
WASABI_AVATAR_BUCKET_NAME=hossavatars
WASABI_REGION=us-east-1
WASABI_ENDPOINT_URL=https://s3.wasabisys.com

# Auth (genera con: openssl rand -hex 32)
JWT_SECRET=
CSRF_SECRET=
JWT_EXPIRE_MINUTES=480

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# Asistente MAX en el chat (vacío = OPENROUTER_MODEL; debe soportar tool calling).
# Límites y topes con default en app/config.py (ASSISTANT_USER_PER_MINUTE=5,
# ASSISTANT_USER_PER_DAY=50, ASSISTANT_CONV_PER_HOUR=30, ASSISTANT_MAX_TOOL_CALLS=6…)
# ASSISTANT_MODEL=

# Widget de reportes (usa OPENROUTER_API_KEY para Jev)
# Orígenes coma-separados que pueden enviar reportes desde el widget
REPORT_WIDGET_ORIGINS=https://app.hoss.com.mx
# Opcionales (override de defaults):
# JEV_MODEL=typesafe/jev-1.13
# REPORT_TRIAGE_DEPARTMENT=Sistemas

# Valkey (opcional — omitir si no se usa)
VALKEY_URL=

# Stickers del chat (https://mssgs-stickers.com/developers; opcional)
MSSGS_STICKERS_API_KEY=
